# BCON — environment configuration
#
# Copy this file to `.env` and fill in the values you actually use.
# Every variable below is optional: with none of them set the enquiry form
# still works, it records the enquiry server-side and asks the visitor to
# email us directly instead of pretending to deliver a message.
#
# Never commit `.env` — it must stay local / on the server.

# ---------------------------------------------------------------------------
# Email delivery (Resend)
# ---------------------------------------------------------------------------
# Requires RESEND_API_KEY *and* ENQUIRY_FROM_EMAIL to be set; both are needed
# before the email channel is considered active.
#
# RESEND_API_KEY        API key from https://resend.com/api-keys
# ENQUIRY_FROM_EMAIL    Verified sender, e.g. "BCON Website <website@yourdomain.com>"
# ENQUIRY_TO_EMAIL      Where enquiries should land. Defaults to the `email`
#                       value in src/config/site.ts when omitted.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ENQUIRY_FROM_EMAIL="BCON Website <website@yourdomain.com>"
# ENQUIRY_TO_EMAIL=hello@yourdomain.com

# ---------------------------------------------------------------------------
# WhatsApp delivery (Meta Cloud API)
# ---------------------------------------------------------------------------
# Requires WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_TO_NUMBER
# before the WhatsApp channel is considered active.
#
# WHATSAPP_TOKEN          System user token from the Meta developer dashboard
# WHATSAPP_PHONE_NUMBER_ID  Phone number ID that sends the messages
# WHATSAPP_TO_NUMBER      Destination number in international format, digits only
# WHATSAPP_NUMBER         Public number used for the "click to chat" fallback
#                         link when the API is not configured. Defaults to the
#                         `whatsapp` value in src/config/site.ts when omitted.

# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO_NUMBER=
# WHATSAPP_NUMBER=15551234567
